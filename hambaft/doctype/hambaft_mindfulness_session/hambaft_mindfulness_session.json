{
 "doctype": "DocType",
 "name": "Hambaft Mindfulness Session",
 "module": "Hambaft",
 "custom": 0,
 "autoname": "format:MND-{#####}",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "کاربر",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "session_date",
   "fieldtype": "Date",
   "label": "تاریخ",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "session_type",
   "fieldtype": "Select",
   "label": "نوع",
   "options": "meditation\nbreathing\nbody-scan\ngratitude",
   "default": "meditation"
  },
  {
   "fieldname": "duration_minutes",
   "fieldtype": "Int",
   "label": "دقیقه",
   "default": 0
  },
  {
   "fieldname": "stress_before",
   "fieldtype": "Int",
   "label": "استرس قبل",
   "default": 0
  },
  {
   "fieldname": "stress_after",
   "fieldtype": "Int",
   "label": "استرس بعد",
   "default": 0
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "یادداشت"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Hambaft User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  },
  {
   "role": "All",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  }
 ],
 "sort_field": "session_date",
 "sort_order": "DESC"
}
