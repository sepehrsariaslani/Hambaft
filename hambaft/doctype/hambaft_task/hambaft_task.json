{
  "name": "Hambaft Task",
  "doctype": "DocType",
  "module": "Hambaft",
  "custom": 0,
  "autoname": "format:TASK-{#####}",
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "عنوان",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "توضیحات"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "وضعیت",
      "options": "انجام‌نشده\nدر حال انجام\nانجام‌شده\nلغو‌شده",
      "default": "انجام‌نشده",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "priority",
      "fieldtype": "Select",
      "label": "اولویت",
      "options": "پایین\nمتوسط\nبالا\nفوری",
      "default": "متوسط",
      "in_list_view": 1
    },
    {
      "fieldname": "due_date",
      "fieldtype": "Date",
      "label": "مهلت",
      "in_list_view": 1
    },
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "label": "کاربر",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "completed",
      "fieldtype": "Check",
      "label": "انجام شده",
      "default": 0
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "All",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "if_owner": 1
    }
  ],
  "sort_field": "due_date",
  "sort_order": "ASC",
  "istable": 1,
  "issingle": 0
}