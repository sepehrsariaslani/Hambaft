{
 "name": "Hambaft Recurrence Rule",
 "doctype": "DocType",
 "module": "Hambaft",
 "label": "قانون تکرار",
 "custom": 0,
 "autoname": "format:REC-{#####}",
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "عنوان",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "کاربر",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "frequency",
   "fieldtype": "Select",
   "label": "تکرار",
   "options": "روزانه\nهفتگی\nماهانه\nسالانه\nسفارشی",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "interval",
   "fieldtype": "Int",
   "label": "فاصله",
   "default": "1",
   "description": "تعداد روزها/هفته‌ها/ماه‌ها بین هر تکرار"
  },
  {
   "fieldname": "days_of_week",
   "fieldtype": "Data",
   "label": "روزهای هفته",
   "description": "روزهای انتخاب‌شده به صورت جدا شده با کاما (مثلا: شنبه,یکشنبه)"
  },
  {
   "fieldname": "day_of_month",
   "fieldtype": "Int",
   "label": "روز ماه",
   "description": "روز مشخص در ماه برای تکرار (1-31)"
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "تاریخ شروع",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "تاریخ پایان",
   "description": "تاریخ پایان تکرار (اختیاری = بدون پایان)"
  },
  {
   "fieldname": "repeat_until_count",
   "fieldtype": "Int",
   "label": "تعداد تکرار",
   "description": "حداکثر تعداد دفعات تکرار (0 = نامحدود)"
  },
  {
   "fieldname": "occurrence_count",
   "fieldtype": "Int",
   "label": "تعداد وقوع",
   "default": "0",
   "description": "تعداد دفعاتی که یادآوری ایجاد شده است",
   "read_only": true
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "All",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  }
 ],
 "sort_field": "start_date",
 "sort_order": "ASC"
}
