  {"fieldname": "wake_time", "fieldtype": "Time", "label": "زمان بیداری"},
  {"fieldname": "duration_hours", "fieldtype": "Float", "label": "مدت خواب", "default": 0},
  {"fieldname": "quality", "fieldtype": "Int", "label": "کیفیت", "default": 0},
  {"fieldname": "energy_level", "fieldtype": "Int", "label": "انرژی", "default": 0},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "یادداشت"}
