   "options": "User",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "عنوان",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "note_type",
   "fieldtype": "Select",
   "label": "نوع یادداشت",
   "options": "یادداشت روزانه\nیادداشت پروژه\nایده\nمرجع\nجلسه\nتصمیم\nژورنال\nمالی\nسلامت\nسفارشی",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "area",
   "fieldtype": "Link",
   "label": "حوزه",
   "options": "Hambaft Area",
   "in_standard_filter": 1
  },
  {
   "fieldname": "project",
   "fieldtype": "Link",
   "label": "پروژه",
   "options": "Hambaft Project",
   "in_standard_filter": 1
  },
  {
   "fieldname": "goal",
   "fieldtype": "Link",
   "label": "هدف",
   "options": "Hambaft Goal",
   "in_standard_filter": 1
  },
  {
   "fieldname": "content",
   "fieldtype": "Text Editor",
   "label": "محتوا"
  },
  {
   "fieldname": "markdown_content",
   "fieldtype": "Long Text",
   "label": "محتوای مارک‌داون"
  },
  {
   "fieldname": "is_pinned",
   "fieldtype": "Check",
   "label": "سنجاق‌شده",
   "default": 0
  },
  {
   "fieldname": "is_archived",
   "fieldtype": "Check",
   "label": "بایگانی‌شده",
   "default": 0
