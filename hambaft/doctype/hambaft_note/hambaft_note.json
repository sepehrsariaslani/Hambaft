  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Hambaft User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  },
  {
   "role": "All",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "istable": 0,
 "issingle": 0
}
