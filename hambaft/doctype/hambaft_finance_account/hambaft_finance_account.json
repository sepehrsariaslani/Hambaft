{
 "name": "Hambaft Finance Account",
 "doctype": "DocType",
 "module": "Hambaft",
 "custom": 0,
 "autoname": "format:ACCT-{#####}",
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "allow_import": 1,
 "fields": [
  {
   "fieldname": "account_name",
   "fieldtype": "Data",
   "label": "نام حساب",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "کاربر",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "account_type",
   "fieldtype": "Select",
   "label": "نوع حساب",
   "options": "نقدی\nبانک\nکارت\nپس‌انداز\nسرمایه‌گذاری\nبدهی\nکیف پول\nسایر",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "واحد پول",
   "options": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "opening_balance",
   "fieldtype": "Currency",
   "label": "موجودی اولیه",
   "default": 0
  },
  {
   "fieldname": "current_balance",
   "fieldtype": "Currency",
   "label": "موجودی فعلی",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "فعال",
   "default": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "color",
   "fieldtype": "Color",
   "label": "رنگ"
  },
  {
   "fieldname": "icon",
   "fieldtype": "Data",
   "label": "آیکون"
  },
  {
   "fieldname": "bank_name",
   "fieldtype": "Data",
   "label": "نام بانک",
   "depends_on": "eval:doc.account_type == 'بانک'"
  },
  {
   "fieldname": "account_number",
   "fieldtype": "Data",
   "label": "شماره حساب"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "توضیحات"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Hambaft User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  },
  {
   "role": "All",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "if_owner": 1
  }
 ],
 "sort_field": "account_name",
 "sort_order": "ASC"
}
