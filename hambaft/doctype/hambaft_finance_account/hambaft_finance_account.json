    {"fieldname": "account_type", "fieldtype": "Select", "label": "\u0646\u0648\u0639 \u062d\u0633\u0627\u0628", "options": "\u0646\u0642\u062f\u06cc\n\u0628\u0627\u0646\u06a9\n\u06a9\u0627\u0631\u062a\n\u067e\u0633\u200c\u0627\u0646\u062f\u0627\u0632\n\u0633\u0631\u0645\u0627\u06cc\u0647\u200c\u06af\u0630\u0627\u0631\u06cc\n\u0628\u062f\u0647\u06cc\n\u06a9\u06cc\u0641 \u067e\u0648\u0644\n\u0633\u0627\u06cc\u0631", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
